# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/merb-starterpack

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# JWT — use long random strings in production (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Email (BullMQ worker + nodemailer).
# Leave SMTP_URL empty to log emails instead of sending them (dev mode).
SMTP_URL=
MAIL_FROM="Merb Starter <no-reply@example.com>"

# Set to true to run the BullMQ email worker inside the API process.
# In Docker Compose the worker runs as a separate service instead.
RUN_INLINE_WORKER=false

# Seed on startup: system roles + initial admin user
SEED_ON_START=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!

# Public URL of the frontend (used in email links)
APP_URL=http://localhost:5173
