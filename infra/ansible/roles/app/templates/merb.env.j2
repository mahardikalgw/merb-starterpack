# Managed by Ansible — merb-starterpack ({{ inventory_hostname }})
# Do NOT commit the rendered file.
NODE_ENV=production
PORT=3000

MONGODB_URI={{ vault_mongodb_uri | default('mongodb://mongo:27017/merb-starterpack') }}
REDIS_URL={{ vault_redis_url | default('redis://redis:6379') }}

JWT_ACCESS_SECRET={{ vault_jwt_access_secret }}
JWT_REFRESH_SECRET={{ vault_jwt_refresh_secret }}
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

SMTP_URL={{ vault_smtp_url }}
MAIL_FROM={{ mail_from }}

RUN_INLINE_WORKER=false

SEED_ON_START={{ seed_on_start }}
SEED_ADMIN_EMAIL={{ seed_admin_email }}
SEED_ADMIN_PASSWORD={{ vault_seed_admin_password }}

APP_URL=https://{{ app_domain }}
